---
import { site } from '../data/site';
import { url } from '../lib/url';

// `id` is the section each link points at; the script below uses it to highlight the current one.
const links = [
  { label: 'About', id: 'about' },
  { label: 'Projects', id: 'projects' },
  { label: 'Tools', id: 'tools' },
  { label: 'Certificates', id: 'other' },
  { label: 'Contact', id: 'contact' },
];

// Pages that do not exist yet: listed in the nav, greyed out, with a "soon" tag.
const upcoming = ['Videos'];
---

<header class="sticky top-0 z-40 bg-void">
  <div class="container-page relative flex h-16 items-center justify-between gap-6">
    <!-- Wordmark styled as a terminal prompt: > russm_ -->
    <a
      href={url('/')}
      class="flex items-center gap-2 font-display text-base leading-none text-white"
      aria-label={`${site.name}, home`}
    >
      <span class="text-magenta" aria-hidden="true">&gt;</span>
      <span class="glitch" data-text={site.handle}>{site.handle}</span>
      <span class="h-[1em] w-[0.5em] animate-blink bg-cyan" aria-hidden="true"></span>
    </a>

    <nav aria-label="Main" class="relative hidden lg:block">
      <ul class="flex items-center gap-6 xl:gap-8">
        {
          links.map((link, i) => (
            <li>
              <a
                href={url(`/#${link.id}`)}
                data-nav-link={link.id}
                class="font-mono text-xs tracking-[0.18em] text-muted uppercase transition-colors hover:text-white aria-[current]:text-cyan"
              >
                <span class="text-[0.65rem] text-magenta">0{i + 1}</span>{' '}
                {link.label}
              </a>
            </li>
          ))
        }
        {
          upcoming.map((label) => (
            <li class="font-mono text-xs tracking-[0.18em] text-muted/60 uppercase" title={`${label}: coming soon`}>
              {label}{' '}
              <span class="border border-line px-1 py-0.5 text-[0.6rem] tracking-[0.12em] text-acid/80">soon</span>
            </li>
          ))
        }
      </ul>
      <span class="nav-indicator" data-nav-indicator aria-hidden="true"></span>
    </nav>

    <!-- Live clock for where I am. -->
    <p
      class="hidden items-center gap-2 font-mono text-xs tracking-[0.18em] text-muted uppercase xl:flex"
      title="Philippine time"
    >
      <span class="size-1.5 animate-flicker bg-acid shadow-[0_0_8px_var(--color-acid)]" aria-hidden="true"></span>
      PHT
      <span data-clock class="text-fg tabular-nums">--:--:--</span>
    </p>

    <button
      type="button"
      data-menu-button
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="btn btn-line panel h-10 cursor-pointer px-4 text-[0.65rem] lg:hidden"
    >
      Menu
    </button>

    <ul id="mobile-menu" hidden class="panel absolute inset-x-5 top-full mt-3 px-5 py-2 sm:inset-x-8 lg:hidden">
      {
        links.map((link, i) => (
          <li class="border-b border-line last:border-b-0">
            <a
              href={url(`/#${link.id}`)}
              class="block py-4 font-mono text-sm tracking-[0.2em] text-fg uppercase hover:text-cyan"
            >
              <span class="text-magenta">0{i + 1}</span>{' '}
              {link.label}
            </a>
          </li>
        ))
      }
      {
        upcoming.map((label) => (
          <li class="border-t border-line py-4 font-mono text-sm tracking-[0.2em] text-muted/60 uppercase">
            {label}{' '}
            <span class="border border-line px-1 py-0.5 text-[0.65rem] tracking-[0.12em] text-acid/80">soon</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- An energy bar that fills from the left as the page scrolls. The mask cuts it into segments;
       it sits on the track, not the fill, so the segments stay put while the fill grows. -->
  <div class="relative h-1 bg-line [mask-image:repeating-linear-gradient(90deg,#000_0_10px,transparent_10px_12px)]">
    <div data-scroll-progress class="absolute inset-0 origin-left scale-x-0 bg-cyan"></div>
  </div>
</header>

<script>
  // --- Clock ---
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const format = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Manila',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    });
    const tick = () => (clock.textContent = format.format(new Date()));
    tick();
    setInterval(tick, 1000);
  }

  // --- Scroll progress and current-section highlight ---
  const progress = document.querySelector<HTMLElement>('[data-scroll-progress]');
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const indicator = document.querySelector<HTMLElement>('[data-nav-indicator]');
  const sections = navLinks.map((link) => document.getElementById(link.dataset.navLink ?? ''));

  const update = () => {
    const scrollable = document.documentElement.scrollHeight - innerHeight;
    if (progress) progress.style.scale = `${scrollable > 0 ? Math.min(1, scrollY / scrollable) : 0} 1`;

    // The current section is the last one whose top has passed 40% of the way down the window.
    let current = -1;
    sections.forEach((section, i) => {
      if (section && section.getBoundingClientRect().top <= innerHeight * 0.4) current = i;
    });

    navLinks.forEach((link, i) => {
      if (i === current) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });

    if (indicator) {
      const link = navLinks[current];
      // offsetParent is null while the nav is hidden on small screens.
      if (link?.offsetParent) {
        indicator.style.opacity = '1';
        indicator.style.width = `${link.offsetWidth}px`;
        indicator.style.translate = `${link.offsetLeft}px 0`;
      } else {
        indicator.style.opacity = '0';
      }
    }
  };

  // Scroll events already fire at most once per frame, so this needs no extra throttling.
  addEventListener('scroll', update, { passive: true });
  addEventListener('resize', update);
  update();

  // --- Mobile menu ---
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.getElementById('mobile-menu');

  if (button && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      button.textContent = open ? 'Close' : 'Menu';
    };

    const isOpen = () => button.getAttribute('aria-expanded') === 'true';

    button.addEventListener('click', () => setOpen(!isOpen()));
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        button.focus();
      }
    });
  }
</script>
