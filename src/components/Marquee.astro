---
import Shape from './Shape.astro';
import { skills } from '../data/site';

const items = skills.flatMap((group) => group.items);
---

<div class="-rotate-1 overflow-hidden border-y-2 border-line bg-sun py-3 text-night">
  <div class="flex w-max animate-marquee hover:[animation-play-state:paused]">
    {
      // Two identical copies so the loop is seamless; the second is hidden from screen readers.
      [false, true].map((isCopy) => (
        <ul class="flex shrink-0 items-center" aria-hidden={isCopy ? 'true' : undefined}>
          {items.map((item) => (
            <li class="flex items-center gap-5 pr-5 font-display text-2xl font-extrabold whitespace-nowrap uppercase">
              {item}
              <Shape kind="spark" class="size-5 fill-pink stroke-night" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>
