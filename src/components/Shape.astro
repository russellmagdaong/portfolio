---
// Decorative sticker shapes. Colour them with fill-* / stroke-* classes.
interface Props {
  kind?: 'spark' | 'burst' | 'blob' | 'flower' | 'squiggle' | 'ring';
  class?: string;
}

const { kind = 'spark', class: className } = Astro.props;

const burstPoints = Array.from({ length: 24 }, (_, i) => {
  const radius = i % 2 === 0 ? 48 : 35;
  const angle = (Math.PI * 2 * i) / 24 - Math.PI / 2;
  return `${(50 + radius * Math.cos(angle)).toFixed(1)},${(50 + radius * Math.sin(angle)).toFixed(1)}`;
}).join(' ');

const petals = Array.from({ length: 6 }, (_, i) => {
  const angle = (Math.PI * 2 * i) / 6;
  return { cx: (50 + 27 * Math.cos(angle)).toFixed(1), cy: (50 + 27 * Math.sin(angle)).toFixed(1) };
});
---

<svg
  viewBox="0 0 100 100"
  aria-hidden="true"
  data-shape
  class:list={['overflow-visible', className]}
  stroke-width="2.5"
  stroke-linejoin="round"
  stroke-linecap="round"
>
  {
    kind === 'spark' && (
      <path
        vector-effect="non-scaling-stroke"
        d="M50 2C54 34 66 46 98 50C66 54 54 66 50 98C46 66 34 54 2 50C34 46 46 34 50 2Z"
      />
    )
  }
  {kind === 'burst' && <polygon vector-effect="non-scaling-stroke" points={burstPoints} />}
  {
    kind === 'blob' && (
      <path
        vector-effect="non-scaling-stroke"
        d="M52 5c23 1 42 15 43 39s-13 49-41 51S8 80 5 55 27 4 52 5Z"
      />
    )
  }
  {
    kind === 'flower' && (
      <>
        {petals.map((petal) => <circle vector-effect="non-scaling-stroke" cx={petal.cx} cy={petal.cy} r="21" />)}
        <circle vector-effect="non-scaling-stroke" cx="50" cy="50" r="15" class="fill-white" />
      </>
    )
  }
  {
    kind === 'squiggle' && (
      <path
        vector-effect="non-scaling-stroke"
        fill="none"
        stroke-width="7"
        d="M4 50Q16 22 28 50T52 50T76 50T96 50"
      />
    )
  }
  {kind === 'ring' && <circle vector-effect="non-scaling-stroke" fill="none" stroke-width="7" cx="50" cy="50" r="40" />}
</svg>
