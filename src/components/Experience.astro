---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/site';
import { accentAt, accentBg } from '../lib/accent';
---

<section id="experience" class="container-page py-20 sm:py-28">
  <SectionHeading kicker="04 / experience" title="Where I've been" accent="tang" />

  <ol class="relative space-y-8 border-l-2 border-dashed border-line pl-8 sm:pl-12">
    {
      experience.map((item, i) => (
        <li class="relative">
          <span
            class:list={[
              'absolute top-6 -left-8 size-5 -translate-x-1/2 rounded-full border-2 border-line sm:-left-12',
              accentBg[accentAt(i)],
            ]}
          />
          <article class="card p-6 sm:p-8">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
              <h3 class="text-2xl font-extrabold">
                {item.role}
                <span class="font-semibold text-muted"> @ {item.company}</span>
              </h3>
              <p class="chip font-mono">{item.period}</p>
            </div>
            <p class="mt-3 text-lg text-muted">{item.summary}</p>
            {item.highlights.length > 0 && (
              <ul class="mt-4 list-disc space-y-1.5 pl-5 marker:text-pink">
                {item.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
          </article>
        </li>
      ))
    }
  </ol>
</section>
