---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import player from '../assets/hero/player.png';
import { dialogue, site, socials } from '../data/site';
import { url } from '../lib/url';

const [firstName, ...rest] = site.name.split(' ');
const lastName = rest.join(' ');

// The photos named in site.photos, looked up in src/assets/pics/. With none, a placeholder is shown.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/pics/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const photos = site.photos.map((name) => {
  const file = files[`../assets/pics/${name}`];
  if (!file) throw new Error(`Photo not found: src/assets/pics/${name}`);
  return file.default;
});
---

<section class="relative overflow-hidden">
  <div class="horizon" aria-hidden="true"><div><div></div></div></div>

  <div class="container-page relative grid items-center gap-12 pt-12 pb-20 sm:pt-16 sm:pb-28 lg:grid-cols-[1.25fr_0.75fr]">
    <div class="min-w-0">
      {
        site.status && (
          <p class="rise flex items-center gap-3 font-mono text-xs tracking-[0.18em] text-acid uppercase sm:text-sm">
            <span class="size-2 shrink-0 animate-flicker bg-acid shadow-[0_0_10px_var(--color-acid)]" />
            {site.status}
          </p>
        )
      }

      <h1
        class="rise mt-6 font-display text-[2rem] leading-[1.15] text-white uppercase sm:text-5xl lg:text-[3.5rem] xl:text-[4rem]"
        style="--i:1"
      >
        <span class="glitch block" data-text={firstName}>{firstName}</span>
        <span class="glitch block text-cyan" data-text={lastName}>{lastName}</span>
      </h1>

      <p class="rise mt-6 font-mono text-xs tracking-[0.2em] text-muted uppercase sm:text-sm" style="--i:2">{site.role}</p>

      <!--
        Terminal line: the tagline lines type themselves out in turn. Every one of them is also
        laid out unseen in the same cell of a grid, which makes the block exactly as tall as the
        tallest of them at whatever width it has: no room is kept that no line uses, and nothing
        under it moves when a longer line comes round. The cursor takes up no room of its own,
        so the line being typed always wraps where its unseen copy does.
      -->
      <div class="rise mt-7 border-l-2 border-magenta pl-4" data-lines={JSON.stringify(dialogue)} style="--i:3">
        <div class="grid grid-cols-1 font-mono text-base text-fg sm:text-lg" aria-hidden="true">
          {dialogue.map((line) => <p class="invisible col-start-1 row-start-1">&gt; {line}</p>)}
          <p class="col-start-1 row-start-1">
            <span class="text-magenta">&gt;</span>{' '}
            <span data-typed>{dialogue[0]}</span><span class="relative"><span class="absolute bottom-0 left-0.5 h-[1.05em] w-[0.55em] animate-blink bg-cyan"></span></span><span data-rest class="invisible"></span>
          </p>
        </div>
        <p class="sr-only">{dialogue.join(' ')}</p>
      </div>

      <div class="rise mt-9 flex flex-wrap gap-3" style="--i:4">
        <a href={url('/#projects')} class="btn btn-solid" data-accent="acid"><Icon name="play" />Projects</a>
        {
          socials.map((social) => (
            <a
              href={social.href}
              class="btn btn-line panel"
              target={social.href.startsWith('http') ? '_blank' : undefined}
              rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              <Icon name={social.icon} />
              {social.label}
            </a>
          ))
        }
        {
          site.resumeUrl && (
            <a href={url(site.resumeUrl)} class="btn btn-line panel">
              <Icon name="resume" />
              Résumé
            </a>
          )
        }
      </div>
    </div>

    <!--
      Inline, and placed after the terminal line it drives, so the first line starts typing
      before first paint, or as soon as the entry screen (Entry.astro) is dismissed if that is up.
      Without JavaScript the first line just stays on screen.
    -->
    <script is:inline>
      (() => {
        const typed = document.querySelector('[data-typed]');
        const rest = document.querySelector('[data-rest]');
        const lines = JSON.parse(typed.closest('[data-lines]').dataset.lines);
        if (lines.length === 0 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const CHAR_MS = 32;
        const HOLD_MS = 3200;
        let line = 0;
        let shown = 0;

        // The untyped remainder stays in the layout, invisible, so words never jump between rows.
        const tick = () => {
          typed.textContent = lines[line].slice(0, shown);
          rest.textContent = lines[line].slice(shown);
          if (shown < lines[line].length) {
            shown += 1;
            setTimeout(tick, CHAR_MS);
          } else {
            line = (line + 1) % lines.length;
            shown = 0;
            setTimeout(tick, HOLD_MS);
          }
        };

        if (document.documentElement.classList.contains('gated')) {
          document.addEventListener('site:enter', tick, { once: true });
        } else {
          tick();
        }
      })();
    </script>

    <!--
      Hologram portrait with two views: the ODIN player sprite and a real photo.
      The sprite is 44px wide at 1x, so it is shown at exactly 3x or 4x to keep its pixels square.
    -->
    <div
      data-avatar
      style="--i:3"
      class="rise panel panel-run mx-auto w-full max-w-xs [--px:6px] lg:max-w-none"
    >
      <div class="holo panel-inner scanlines relative h-80 overflow-hidden lg:h-[27rem]">
        <div data-avatar-stage class="absolute inset-0">
          <div data-avatar-view="game" class="absolute inset-0 animate-bob">
            <div class="holo-beam" aria-hidden="true"></div>
            <img
              src={player.src}
              width={player.width}
              height={player.height}
              alt={`${site.name} as the pixel-art player character from ODIN`}
              class="holo-sprite pixelated absolute bottom-14 left-1/2 h-auto w-[132px] max-w-none -translate-x-1/2 lg:w-[176px]"
            />
          </div>

          <div data-avatar-view="real" class="absolute inset-0" hidden>
            {
              photos.length > 0 ? (
                photos.map((photo, i) => (
                  <Image
                    src={photo}
                    width={800}
                    alt={i === 0 ? `Photo of ${site.name}` : ''}
                    data-avatar-photo
                    class:list={[
                      'absolute inset-0 size-full object-cover object-top transition-opacity duration-700',
                      i !== 0 && 'opacity-0',
                    ]}
                  />
                ))
              ) : (
                // Placeholder until a real photo is added.
                <div class="grid size-full place-items-center pb-10 text-center">
                  <div>
                    <svg viewBox="0 0 120 130" class="mx-auto w-32 text-cyan lg:w-40" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="5 5" aria-hidden="true">
                      <circle cx="60" cy="42" r="26" />
                      <path d="M8 128c4-30 26-44 52-44s48 14 52 44" />
                    </svg>
                    <p class="mt-4 font-mono text-[0.7rem] tracking-[0.22em] text-cyan uppercase">Photo placeholder</p>
                    <p class="mt-1 font-mono text-[0.65rem] tracking-wide text-muted">add src/assets/hero/photo.jpg</p>
                  </div>
                </div>
              )
            }
          </div>
        </div>

        <div class="absolute inset-x-0 top-0 h-[10%] animate-scan bg-gradient-to-b from-transparent via-cyan/25 to-transparent" aria-hidden="true"></div>
        <p class="absolute top-4 left-5 font-mono text-[0.65rem] tracking-[0.22em] text-cyan uppercase" aria-hidden="true">
          ID {site.handle}
        </p>

        <!-- Sits above the scanlines so the label stays crisp. One button flips between the two views. -->
        <div class="absolute inset-x-0 bottom-3 z-10 flex justify-center">
          <button
            type="button"
            data-avatar-toggle
            class="group flex cursor-pointer items-center gap-2 border-2 border-cyan bg-void px-4 py-2 font-mono text-[0.7rem] tracking-[0.2em] text-cyan uppercase transition-colors hover:bg-cyan hover:text-void"
          >
            <Icon name="swap" class="size-4 transition-transform duration-500 group-hover:rotate-180" />
            <span data-avatar-label>De-pixelate</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Flip the portrait between the game sprite and the real photo, with a burst of static.
  const frame = document.querySelector<HTMLElement>('[data-avatar]');
  const toggle = frame?.querySelector<HTMLButtonElement>('[data-avatar-toggle]');
  const label = frame?.querySelector<HTMLElement>('[data-avatar-label]');

  if (frame && toggle && label) {
    const views = [...frame.querySelectorAll<HTMLElement>('[data-avatar-view]')];
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // The swap happens partway through the static, so the change itself is hidden by it.
    const SWAP_AT_MS = 150;
    const STATIC_MS = 420;
    let showing = 'game';

    // While the real view is up, fade through the photos.
    const photos = [...frame.querySelectorAll<HTMLElement>('[data-avatar-photo]')];
    const PHOTO_MS = 4000;
    let current = 0;
    let timer: number | undefined;
    const cycle = (on: boolean) => {
      window.clearInterval(timer);
      if (!on || photos.length < 2 || reducedMotion) return;
      timer = window.setInterval(() => {
        current = (current + 1) % photos.length;
        photos.forEach((photo, i) => photo.classList.toggle('opacity-0', i !== current));
      }, PHOTO_MS);
    };

    toggle.addEventListener('click', () => {
      showing = showing === 'game' ? 'real' : 'game';
      // The label names what the next press will do.
      label.textContent = showing === 'game' ? 'De-pixelate' : 'Pixelate';
      cycle(showing === 'real');
      const swap = () => views.forEach((view) => (view.hidden = view.dataset.avatarView !== showing));

      if (reducedMotion) {
        swap();
        return;
      }
      frame.classList.add('is-switching');
      setTimeout(swap, SWAP_AT_MS);
      setTimeout(() => frame.classList.remove('is-switching'), STATIC_MS);
    });
  }
</script>
