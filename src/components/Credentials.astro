---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { achievements, certificates } from '../data/site';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/certificates/*/*.jpg', { eager: true });

// Pair every entry in site.ts with its image; a missing file fails the build with its name.
const groups = certificates.map((group, g) => ({
  ...group,
  id: `certs-${group.folder}`,
  accent: (['cyan', 'magenta', 'acid', 'violet'] as const)[g % 4],
  items: group.items.map((item) => {
    const path = `../assets/certificates/${group.folder}/${item.file}.jpg`;
    const file = files[path];
    if (!file) throw new Error(`Certificate image not found: ${path}`);
    return { ...item, image: file.default };
  }),
}));
---

<section id="other" class="container-page py-16 sm:py-24" data-accent="violet">
  <SectionHeading index="04" kicker="Credentials" title="Other things" />

  <ul class="grid gap-5 md:grid-cols-3" data-stagger>
    {
      achievements.map((item, i) => (
        <li
          class="neon-box neon-run flex items-start gap-4 p-5 transition-[translate] duration-200 hover:-translate-y-1"
          data-spotlight
          style={`--i:${i * 2}`}
        >
          <Icon name="badge" class="text-accent mt-0.5 size-7 animate-flicker" />
          <div>
            <p class="font-display text-lg leading-snug font-bold text-white">{item.title}</p>
            {item.detail && <p class="mt-1 text-sm text-muted">{item.detail}</p>}
          </div>
        </li>
      ))
    }
  </ul>

  <!-- Certificates stay out of sight until one of these buttons is pressed. One group is open at a time. -->
  <div id="certificates" class="mt-14" data-certificates>
    <h3 class="font-mono text-sm tracking-[0.2em] text-accent uppercase" data-reveal="left">
      <span class="text-muted">//</span>{' '}Certificates
    </h3>

    <div class="mt-5 flex flex-wrap gap-3" data-stagger>
      {
        groups.map((group, i) => (
          <button
            type="button"
            class="btn btn-line neon-box cursor-pointer aria-expanded:[--fill:var(--accent)] aria-expanded:text-void"
            data-accent={group.accent}
            data-cert-button
            aria-expanded="false"
            aria-controls={group.id}
            style={`--i:${i}`}
          >
            {group.label}
            <span class="font-mono text-xs opacity-70">{String(group.items.length).padStart(2, '0')}</span>
          </button>
        ))
      }
    </div>

    {
      groups.map((group) => (
        <ul id={group.id} hidden class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-accent={group.accent} data-stagger>
          {group.items.map((item, i) => (
            <li style={`--i:${i}`}>
              <button
                type="button"
                data-cert-open={item.image.src}
                data-cert-title={item.title}
                class="neon-box group block w-full cursor-pointer text-left transition-[translate] duration-200 [--cut:14px] hover:-translate-y-1"
              >
                <span class="cut-inner m-px block overflow-hidden bg-[#090814]">
                  <Image
                    src={item.image}
                    width={640}
                    alt=""
                    class="aspect-[4/3] w-full object-contain transition-transform duration-500 group-hover:scale-[1.04]"
                  />
                </span>
                <span class="block px-4 pt-3 font-display leading-snug font-bold text-white">{item.title}</span>
                <span class="block px-4 pt-1 pb-4 text-sm text-muted">{item.detail}</span>
              </button>
            </li>
          ))}
        </ul>
      ))
    }
  </div>

  <!-- Full-size view. A native dialog: Escape closes it and focus is kept inside. -->
  <dialog
    data-cert-dialog
    class="m-auto max-h-[92dvh] w-[min(92vw,72rem)] bg-transparent p-0 backdrop:bg-void/90 backdrop:backdrop-blur-sm"
  >
    <div class="flex items-center justify-between gap-4 border border-line bg-deck px-4 py-2.5">
      <p data-cert-caption class="font-display font-bold tracking-wide text-white"></p>
      <button type="button" data-cert-close aria-label="Close" class="cursor-pointer p-1 text-cyan hover:text-white">
        <Icon name="close" />
      </button>
    </div>
    <img data-cert-full alt="" class="max-h-[82dvh] w-full border border-t-0 border-line bg-[#090814] object-contain" />
  </dialog>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-certificates]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-cert-dialog]');

  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-cert-button]')];

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        // Pressing the open group's button closes it; pressing another swaps to that one.
        buttons.forEach((other) => {
          const show = other === button && open;
          other.setAttribute('aria-expanded', String(show));
          const panel = document.getElementById(other.getAttribute('aria-controls') ?? '');
          if (panel) panel.hidden = !show;
        });
      });
    });
  }

  if (root && dialog) {
    const full = dialog.querySelector<HTMLImageElement>('[data-cert-full]');
    const caption = dialog.querySelector<HTMLElement>('[data-cert-caption]');

    root.querySelectorAll<HTMLButtonElement>('[data-cert-open]').forEach((card) => {
      card.addEventListener('click', () => {
        if (!full || !caption) return;
        full.src = card.dataset.certOpen ?? '';
        full.alt = `Certificate: ${card.dataset.certTitle}`;
        caption.textContent = card.dataset.certTitle ?? '';
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-cert-close]')?.addEventListener('click', () => dialog.close());
    // A click on the dimmed area around the picture lands on the dialog element itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
