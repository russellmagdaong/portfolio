---
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

// A store-page style preview: one large image, a strip of thumbnails under it, arrows, swipe,
// and a slow auto-advance that stops for good as soon as the viewer takes over.
interface Props {
  images: { src: ImageMetadata; alt: string }[];
  // What the images are of, for the control labels, e.g. "ODIN".
  label: string;
}

const { images, label } = Astro.props;
const many = images.length > 1;
const pad = (n: number) => String(n).padStart(2, '0');

// Logos are small pixel art: give them breathing room and keep their pixels hard-edged.
// Screenshots are served untouched and fitted whole, so nothing is cropped.
const fit = (image: ImageMetadata) => (image.width < 400 ? 'pixelated object-contain p-[9%]' : 'object-contain');
---

<div data-gallery>
  <div class="panel [--bw:2px] [--px:4px]">
    <div
      data-stage
      class="holo panel-inner relative aspect-video touch-pan-y overflow-hidden select-none"
      role="group"
      aria-roledescription="carousel"
      aria-label={`${label} previews`}
    >
      {
        images.map((image, i) => (
          <img
            data-slide
            src={image.src.src}
            width={image.src.width}
            height={image.src.height}
            alt={image.alt}
            aria-hidden={i === 0 ? undefined : 'true'}
            loading="lazy"
            decoding="async"
            draggable="false"
            class:list={[
              'absolute inset-0 size-full transition-opacity duration-300',
              fit(image.src),
              i !== 0 && 'opacity-0',
            ]}
          />
        ))
      }

      {
        many && (
          <>
            <p
              data-counter
              class="absolute top-3 left-3 bg-void/80 px-2 py-1 font-mono text-[0.65rem] tracking-[0.2em] text-fg"
              aria-hidden="true"
            >
              {pad(1)} / {pad(images.length)}
            </p>
            <button
              type="button"
              data-prev
              aria-label="Previous image"
              class="text-accent absolute top-1/2 left-3 grid size-9 -translate-y-1/2 cursor-pointer place-items-center bg-void/80 transition-colors hover:bg-white hover:text-void"
            >
              <Icon name="chevron" class="rotate-180" />
            </button>
            <button
              type="button"
              data-next
              aria-label="Next image"
              class="text-accent absolute top-1/2 right-3 grid size-9 -translate-y-1/2 cursor-pointer place-items-center bg-void/80 transition-colors hover:bg-white hover:text-void"
            >
              <Icon name="chevron" />
            </button>
            {/* Fills while the next image is on its way. */}
            <div data-progress class="bg-accent absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0" />
          </>
        )
      }
    </div>
  </div>

  {
    many && (
      <div data-thumbs class="mt-3 flex gap-2 overflow-x-auto pb-1.5">
        {images.map((image, i) => (
          <button
            type="button"
            data-thumb
            class="thumb"
            aria-label={`Show image ${i + 1} of ${images.length}: ${image.alt}`}
            aria-current={i === 0 ? 'true' : undefined}
          >
            <img
              src={image.src.src}
              alt=""
              loading="lazy"
              decoding="async"
              draggable="false"
              class:list={['size-full', image.src.width < 400 ? 'pixelated object-contain p-1.5' : 'object-cover']}
            />
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  const AUTO_MS = 4500;
  const SWIPE_PX = 40;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const stage = gallery.querySelector<HTMLElement>('[data-stage]');
    const slides = [...gallery.querySelectorAll<HTMLImageElement>('[data-slide]')];
    const thumbs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    const strip = gallery.querySelector<HTMLElement>('[data-thumbs]');
    const counter = gallery.querySelector<HTMLElement>('[data-counter]');
    const bar = gallery.querySelector<HTMLElement>('[data-progress]');
    if (!stage || slides.length < 2) return;

    const pad = (n: number) => String(n).padStart(2, '0');
    let index = 0;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        slide.classList.toggle('opacity-0', i !== index);
        if (i === index) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
      });
      thumbs.forEach((thumb, i) => {
        if (i === index) thumb.setAttribute('aria-current', 'true');
        else thumb.removeAttribute('aria-current');
      });
      if (counter) counter.textContent = `${pad(index + 1)} / ${pad(slides.length)}`;

      // Keep the active thumbnail in view. Done by hand: scrollIntoView could move the whole page.
      const thumb = thumbs[index];
      if (strip && thumb) {
        strip.scrollTo({
          left: thumb.offsetLeft - (strip.clientWidth - thumb.offsetWidth) / 2,
          behavior: reducedMotion ? 'auto' : 'smooth',
        });
      }
    };

    // --- Auto-advance: only while on screen, paused under the pointer or focus, off after any manual step ---
    let auto = !reducedMotion;
    let onScreen = false;
    let held = false;
    let timer: number | undefined;
    let countdown: Animation | undefined;

    const schedule = () => {
      window.clearTimeout(timer);
      countdown?.cancel();
      if (!auto || !onScreen || held) return;
      countdown = bar?.animate([{ scale: '0 1' }, { scale: '1 1' }], { duration: AUTO_MS, easing: 'linear' });
      timer = window.setTimeout(() => {
        show(index + 1);
        schedule();
      }, AUTO_MS);
    };

    const step = (next: number) => {
      auto = false;
      schedule();
      show(next);
    };

    gallery.querySelector('[data-prev]')?.addEventListener('click', () => step(index - 1));
    gallery.querySelector('[data-next]')?.addEventListener('click', () => step(index + 1));
    thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => step(i)));

    gallery.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      // Claims the keys, so that the project deck around the gallery does not turn as well.
      event.preventDefault();
      step(index + (event.key === 'ArrowLeft' ? -1 : 1));
    });

    const hold = (value: boolean) => () => {
      held = value;
      schedule();
    };
    gallery.addEventListener('pointerenter', hold(true));
    gallery.addEventListener('pointerleave', hold(false));
    gallery.addEventListener('focusin', hold(true));
    gallery.addEventListener('focusout', hold(false));

    new IntersectionObserver(
      ([entry]) => {
        onScreen = entry.isIntersecting;
        schedule();
      },
      { threshold: 0.5 },
    ).observe(stage);

    // --- Swipe on touch screens ---
    let startX: number | undefined;
    stage.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse') startX = event.clientX;
    });
    stage.addEventListener('pointerup', (event) => {
      if (startX === undefined) return;
      const moved = event.clientX - startX;
      startX = undefined;
      if (Math.abs(moved) >= SWIPE_PX) step(index + (moved < 0 ? 1 : -1));
    });
    stage.addEventListener('pointercancel', () => (startX = undefined));
  });
</script>
