---
import SectionHeading from './SectionHeading.astro';
import { tools } from '../data/site';
import { url } from '../lib/url';

const initials = (name: string) => name.replace(/[^A-Za-z]/g, '').slice(0, 2);

// The logos are single-colour SVGs used as masks, so they all take the section's colour.
const mask = (icon: string) => {
  const image = `url(${url(`/icons/${icon}.svg`)}) center / contain no-repeat`;
  return `-webkit-mask: ${image}; mask: ${image};`;
};
---

<section class="container-page py-12 sm:py-16" data-accent="cyan">
  <SectionHeading index="03" kicker="Stack" title="Tools I reach for" />

  <div class="border-b border-line">
    {
      tools.map((group, row) => (
        <div class="grid gap-4 border-t border-line py-6 md:grid-cols-[15rem_1fr] md:items-center">
          <h3 class="font-mono text-sm tracking-[0.2em] text-muted uppercase" data-reveal="left">
            {group.group}
          </h3>
          <ul class="flex flex-wrap gap-3" data-stagger>
            {group.items.map((item, i) => (
              <li
                class="panel group flex items-center gap-3 py-3 pr-5 pl-4 transition-[translate] duration-200 [--px:3px] hover:-translate-y-1 hover:[--line:var(--accent)]"
                style={`--i:${i}`}
              >
                {item.icon ? (
                  <span class="icon-wave bg-accent size-6 shrink-0" style={`${mask(item.icon)} --i:${row * 3 + i}`} />
                ) : (
                  <span
                    class="icon-wave text-accent grid size-6 shrink-0 place-items-center font-mono text-sm font-medium uppercase"
                    style={`--i:${row * 3 + i}`}
                  >
                    {initials(item.name)}
                  </span>
                )}
                <span class="font-medium text-white">{item.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
