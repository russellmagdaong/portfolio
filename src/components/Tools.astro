---
import SectionHeading from './SectionHeading.astro';
import { tools } from '../data/site';
import { url } from '../lib/url';

const accents = ['cyan', 'magenta', 'acid', 'violet'] as const;
const initials = (name: string) => name.replace(/[^A-Za-z]/g, '').slice(0, 2);

// The logos are single-colour SVGs used as masks, so each takes its row's neon colour.
const mask = (icon: string) => {
  const image = `url(${url(`/icons/${icon}.svg`)}) center / contain no-repeat`;
  return `-webkit-mask: ${image}; mask: ${image};`;
};
---

<section id="tools" class="container-page py-16 sm:py-24" data-accent="acid">
  <SectionHeading index="03" kicker="Stack" title="Tools I reach for" />

  <div class="border-b border-line">
    {
      tools.map((group, row) => (
        <div
          class="grid gap-4 border-t border-line py-6 md:grid-cols-[15rem_1fr] md:items-center"
          data-accent={accents[row % accents.length]}
        >
          <h3 class="text-accent font-mono text-sm tracking-[0.2em] uppercase" data-reveal="left">
            {group.group}
          </h3>
          <ul class="flex flex-wrap gap-3" data-stagger>
            {group.items.map((item, i) => (
              <li
                class="neon-box group flex items-center gap-3 py-3 pr-5 pl-4 transition-[translate] duration-200 [--cut:9px] hover:-translate-y-1 hover:[--fill:color-mix(in_oklab,var(--accent)_16%,var(--color-deck))]"
                style={`--i:${i}`}
              >
                {item.icon ? (
                  <span class="icon-wave bg-accent size-6 shrink-0" style={`${mask(item.icon)} --i:${row * 3 + i}`} />
                ) : (
                  <span
                    class="icon-wave text-accent grid size-6 shrink-0 place-items-center font-display text-sm font-extrabold uppercase"
                    style={`--i:${row * 3 + i}`}
                  >
                    {initials(item.name)}
                  </span>
                )}
                <span class="font-display font-semibold tracking-wide text-white">{item.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
