---
// A band of text that scrolls sideways forever. It repeats content that is already on the
// page, so it is hidden from screen readers.
interface Props {
  items: string[];
  // Scroll left-to-right instead of right-to-left.
  reverse?: boolean;
  accent?: 'cyan' | 'magenta' | 'acid' | 'violet';
}

const { items, reverse = false, accent = 'cyan' } = Astro.props;

// Repeat short lists so one copy is always wider than the screen.
const repeats = Math.max(1, Math.ceil(16 / items.length));
const run = Array.from({ length: repeats }, () => items).flat();
---

<div
  class="ticker border-y border-line bg-deck/60 py-3.5"
  data-accent={accent}
  data-reverse={reverse ? '' : undefined}
  aria-hidden="true"
>
  <div>
    {
      // Two identical copies: the track slides by exactly one copy, then loops.
      [0, 1].map(() => (
        <ul class="flex shrink-0 items-center">
          {run.map((item) => (
            <li class="flex items-center gap-6 pr-6 font-display text-lg font-bold tracking-[0.18em] whitespace-nowrap text-fg uppercase">
              {item}
              <span class="text-accent font-mono text-sm">//</span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>
