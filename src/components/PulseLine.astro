---
// A hairline divider between sections with a pulse of neon light travelling along it.
// Purely decorative, so it is hidden from screen readers.
interface Props {
  // Send the pulse right-to-left instead of left-to-right.
  reverse?: boolean;
  accent?: 'cyan' | 'magenta' | 'acid' | 'violet';
}

const { reverse = false, accent = 'cyan' } = Astro.props;
---

<div class="pulse-line" data-accent={accent} data-reverse={reverse ? '' : undefined} aria-hidden="true"></div>
