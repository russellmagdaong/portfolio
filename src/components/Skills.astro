---
import SectionHeading from './SectionHeading.astro';
import { skills } from '../data/site';
import { accentBg } from '../lib/accent';
---

<section id="skills" class="container-page py-20 sm:py-28">
  <SectionHeading kicker="02 / skills" title="My toolbox" accent="sky" />

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      skills.map((group, i) => (
        <article class:list={['card overflow-hidden', i % 2 === 0 ? 'lg:-rotate-1' : 'lg:rotate-1']}>
          <h3 class:list={['border-b-2 border-line px-5 py-3 text-xl font-extrabold text-night', accentBg[group.accent]]}>
            {group.title}
          </h3>
          <ul class="flex flex-wrap gap-2 p-5">
            {group.items.map((item) => (
              <li class="chip hover:animate-wiggle">{item}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
