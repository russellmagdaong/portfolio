---
interface Props {
  // Two-digit section number, e.g. "02".
  index: string;
  kicker: string;
  title: string;
}

const { index, kicker, title } = Astro.props;
---

<header class="mb-10 sm:mb-12" data-reveal>
  <p class="flex items-center gap-3 font-mono text-xs tracking-[0.22em] text-muted uppercase sm:text-sm">
    <span class="arrows text-accent" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="text-accent">{index}</span>
    {kicker}
  </p>
  <div class="mt-4 flex items-end gap-6">
    <!-- data-scramble: the letters decode into place when the heading scrolls in (see effects.ts). -->
    <h2 data-scramble class="title-chrome text-base sm:text-2xl lg:text-[2rem]">{title}</h2>
    <!-- A striped bar that draws itself out to the right and fades. -->
    <div class="rule-draw hatch mb-1.5 hidden h-2.5 flex-1 [mask-image:linear-gradient(to_right,#000,transparent)] sm:block"></div>
  </div>
</header>
