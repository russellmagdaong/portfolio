---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { contact, socials } from '../data/site';
---

<section id="contact" class="container-page py-16 sm:py-24" data-accent="cyan">
  <SectionHeading index="05" kicker="Contact" title="Get in touch" />

  <div class="panel panel-run [--bw:4px] [--line:var(--accent)] [--px:6px]" data-spotlight data-reveal>
    <!-- Links are buttons only: the addresses themselves are never printed on the page. -->
    <div class="p-6 text-center sm:p-12" data-stagger>
      <p class="mx-auto max-w-2xl font-display text-sm leading-[2] text-white sm:text-xl sm:leading-[1.9]" style="--i:2">
        {contact.heading}
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3" style="--i:4">
        {
          socials.map((social, i) => (
            <a
              href={social.href}
              target={social.href.startsWith('http') ? '_blank' : undefined}
              rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class:list={['btn', i === 0 ? 'btn-solid' : 'btn-line panel']}
              data-accent={i === 0 ? 'acid' : undefined}
            >
              <Icon name={social.icon} />
              {social.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
