---
// One screenful of the page. With the script below running, the page stops being one long
// scroll: each stage fills the screen and holds still, and scrolling on changes the picture to
// the next stage, in its place. A stage that is taller than the screen scrolls as usual until
// its end is reached, and holds there. The page never comes to rest half-way between two
// stages: a scroll that leaves one carries on to the next, which settles in the middle of the
// screen.
//
// How it is done (the styles are under "Stages" in global.css): every stage is made a little
// taller than its contents, the screen inside it sticks in place for that extra distance, and
// each stage is pulled up over the end of the one before, so that it is already in position
// when its turn comes. The script decides which screen is showing and how it takes over, and
// enlarges a screen's contents to use the room when the window is bigger than they are.
//
// Without the script the stages are plain blocks, one after another.
interface Props {
  // What links point at, e.g. "projects" for /#projects.
  id?: string;
  // The final stage has nothing to give way to.
  last?: boolean;
}

const { id, last = false } = Astro.props;
---

<div id={id} class="stage" data-page-stage data-last={last ? '' : undefined}>
  <div class="stage-screen" data-screen>
    <div class="stage-fit" data-fit>
      <slot />
    </div>
  </div>
</div>

<script>
  // How near its resting place the next screen has to be before it takes over, as a share of
  // the distance a stage holds for. It appears that far below its place, and the last of the
  // scrolling carries it up into position.
  const TAKEOVER = 0.45;
  // The takeover point is a little further on going forwards than going back, so that
  // resting right on it does not flicker between two screens.
  const SLACK_PX = 10;
  // If an animation's end is never reported, settle the screen anyway.
  const SETTLE_MS = 1100;
  // Scrolling this far away from a stage, and stopping, carries on to the next one. Less than
  // this is taken for a slip of the hand, and the page goes back. It is under one press of an
  // arrow key or one notch of a mouse wheel, so that either is enough to move on.
  const NUDGE_PX = 30;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // A screen's contents are enlarged to take up this much of the room under the header, when
  // they would otherwise sit small in the middle of a big window, but never by more than MAX_FIT.
  const FILL = 0.94;
  const MAX_FIT = 1.3;
  // The widest the page's column gets, in rem: max-w-6xl, as set on .container-page.
  const COLUMN_REM = 72;

  // The ways one picture gives way to the next; each is a set of animations in global.css.
  // Going down the page they are used in this order, one per change of stage. Coming back up,
  // the same change uses the one two places along, so the way back is not the way there.
  const CHANGES = ['scan', 'iris', 'pixels', 'blinds', 'glitch'];
  const BACK_SHIFT = 2;

  const stages = [...document.querySelectorAll<HTMLElement>('[data-page-stage]')];
  const screens = stages.flatMap((stage) => stage.querySelector<HTMLElement>('[data-screen]') ?? []);

  if (stages.length > 1 && screens.length === stages.length) {
    const root = document.documentElement;
    // Turns on the layout in global.css.
    root.classList.add('stages-on');

    // Where the top of a screen rests, under the header; the room a screen has, from there
    // to the bottom of the window; and how far a stage holds for.
    const restingTop = () => parseFloat(getComputedStyle(root).scrollPaddingTop) || 0;
    const room = () => parseFloat(getComputedStyle(screens[0]).minHeight) || innerHeight;
    const hold = () => parseFloat(getComputedStyle(stages[0], '::after').height) || 0;

    // Sections inside a stage that the header links to. A stage can hold more than one.
    const linked = screens.map((screen) =>
      [...screen.querySelectorAll<HTMLElement>('[id]')].filter((el) => document.querySelector(`a[href$="#${el.id}"]`)),
    );

    type State = 'on' | 'off' | 'entering' | 'leaving';
    let active = -1;

    const set = (screen: HTMLElement, state: State) => {
      screen.dataset.screen = state;
      // Whatever happens to the animation, a screen never stays half-way.
      if (state === 'entering' || state === 'leaving') {
        window.setTimeout(() => {
          if (screen.dataset.screen === state) screen.dataset.screen = state === 'entering' ? 'on' : 'off';
        }, SETTLE_MS);
      }
    };

    // Tells the styles which part of a screen is in the window, as distances from the screen's
    // own top edge: --vt to the line under the header, --vb to the bottom of the window. The
    // changes are drawn across that part, so two screens changing at once line up, and a tall
    // screen does not spend most of its change out of sight.
    const frame = (screen: HTMLElement) => {
      const top = screen.getBoundingClientRect().top;
      screen.style.setProperty('--vt', `${restingTop() - top}px`);
      screen.style.setProperty('--vb', `${innerHeight - top}px`);
    };

    // Enlarges a screen's contents to use the room, if they fit with room to spare.
    const fit = (screen: HTMLElement) => {
      const inner = screen.querySelector<HTMLElement>('[data-fit]');
      if (!inner) return;
      const natural = inner.offsetHeight;
      const column = Math.min(innerWidth, COLUMN_REM * parseFloat(getComputedStyle(root).fontSize));
      const scale = natural < room() ? Math.min(MAX_FIT, (FILL * room()) / natural, (0.96 * innerWidth) / column) : 1;
      screen.style.setProperty('--fit', Math.max(1, scale).toFixed(3));
    };

    // The header highlights whichever one element carries data-active: the stage that is
    // showing or, where a stage holds several linked sections, the one of those in view.
    let marked: HTMLElement | null = null;
    const mark = (el: HTMLElement) => {
      if (marked === el) return;
      marked?.removeAttribute('data-active');
      el.setAttribute('data-active', '');
      marked = el;
      document.dispatchEvent(new CustomEvent('stage:change'));
    };
    // A section the visitor asked for by its link stays highlighted until they scroll away.
    let picked: { el: HTMLElement; at: number; when: number } | null = null;

    const show = (to: number, animate: boolean) => {
      const from = active;
      active = to;
      picked = null;
      const forwards = to > from;
      const change = CHANGES[((forwards ? to - 1 : to) + (forwards ? 0 : BACK_SHIFT)) % CHANGES.length];
      screens.forEach((screen, i) => {
        if (i !== to && !(i === from && animate)) return set(screen, 'off');
        frame(screen);
        screen.dataset.change = change;
        screen.dataset.way = forwards ? 'forwards' : 'back';
        set(screen, i === to ? (animate ? 'entering' : 'on') : 'leaving');
      });
      // For the scroll-in reveals and the minigame, which need to know which stage is showing.
      screens[to].dispatchEvent(new CustomEvent('stage:change', { bubbles: true }));
    };

    screens.forEach((screen) => {
      screen.addEventListener('animationend', (event) => {
        // Only the screen's own animation counts, not those of its contents or its scan bar.
        if (event.target !== screen || event.pseudoElement || !event.animationName.startsWith('stage-')) return;
        if (screen.dataset.screen === 'entering') set(screen, 'on');
        if (screen.dataset.screen === 'leaving') set(screen, 'off');
      });
      const inner = screen.querySelector<HTMLElement>('[data-fit]');
      new ResizeObserver(() => {
        fit(screen);
        // A screen taller than the window sticks by its bottom edge, for which the styles need its height.
        screen.style.setProperty('--h', `${screen.offsetHeight}px`);
        update();
      }).observe(inner ?? screen);
    });

    // The stage that is showing is the last one whose place is near enough.
    function update() {
      const top = restingTop();
      const reach = hold() * TAKEOVER;
      let current = 0;
      stages.forEach((stage, i) => {
        const away = stage.getBoundingClientRect().top - top;
        if (away <= reach + (i <= active ? SLACK_PX : -SLACK_PX)) current = i;
      });
      if (current !== active) show(current, active !== -1);

      if (picked && performance.now() - picked.when > 1200 && Math.abs(scrollY - picked.at) > 60) picked = null;
      // Of the linked sections on this stage, the last one that has reached the middle of the window.
      const inView = linked[active].filter((el) => el.getBoundingClientRect().top <= innerHeight * 0.5).pop();
      mark(picked?.el ?? inView ?? stages[active]);
    }

    // Brings a section inside a stage into view: to the stage, and as far down it as it scrolls.
    const goInside = (index: number, target: HTMLElement, behavior: ScrollBehavior = 'auto') => {
      const screen = screens[index];
      const home = scrollY + stages[index].getBoundingClientRect().top - restingTop();
      const spare = Math.max(0, screen.offsetHeight - room());
      const down = target.getBoundingClientRect().top - screen.getBoundingClientRect().top;
      const to = home + Math.min(spare, Math.max(0, down - 24));
      picked = { el: target, at: to, when: performance.now() };
      window.scrollTo({ top: to, behavior });
      // It may already be on screen, in which case nothing moves; effects.ts answers this by
      // running the section's title through its scramble again, so the click is seen to land.
      target.dispatchEvent(new CustomEvent('stage:focus', { bubbles: true }));
      update();
    };

    /*
     * Snapping. The page may rest anywhere within a stage: at its one resting place if it fits
     * the window, or anywhere from its top to its end if it is taller. Between the end of one
     * stage and the top of the next it may not rest. When scrolling stops there, it is carried
     * on the way it was going, or back if it had barely left.
     */
    const place = (index: number) => {
      const top = scrollY + stages[index].getBoundingClientRect().top - restingTop();
      return { top, end: top + Math.max(0, screens[index].offsetHeight - room()) };
    };
    const glide = (top: number) => window.scrollTo({ top, behavior: reducedMotion ? 'auto' : 'smooth' });

    // Which way the page last moved: 1 down, -1 up.
    let heading = 0;
    let lastY = scrollY;
    // A finger on the screen is still scrolling, even while it is not moving.
    let touching = false;

    const settle = () => {
      if (touching || root.classList.contains('gated')) return;
      const y = scrollY;
      for (let i = 0; i < stages.length - 1; i += 1) {
        const from = place(i).end;
        const to = place(i + 1).top;
        if (y <= from + 1 || y >= to - 1) continue;
        const onward = heading > 0 ? y - from > NUDGE_PX : heading < 0 ? to - y <= NUDGE_PX : y - from > (to - from) / 2;
        return glide(onward ? to : from);
      }
    };

    // Browsers that say when a scroll has ended are taken at their word. For the rest, it has
    // ended when nothing has moved for a moment.
    let quiet: number | undefined;
    addEventListener(
      'scroll',
      () => {
        if (scrollY !== lastY) heading = scrollY > lastY ? 1 : -1;
        lastY = scrollY;
        update();
        if ('onscrollend' in window) return;
        window.clearTimeout(quiet);
        quiet = window.setTimeout(settle, 140);
      },
      { passive: true },
    );
    addEventListener('scrollend', settle);
    addEventListener('touchstart', () => (touching = true), { passive: true });
    for (const type of ['touchend', 'touchcancel']) {
      addEventListener(type, () => {
        touching = false;
        if (!('onscrollend' in window)) quiet = window.setTimeout(settle, 140);
      });
    }

    // The keys that page through a document go from stage to stage, one at a time. Inside a
    // stage taller than the window they scroll it as usual until its edge is reached.
    document.addEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.ctrlKey || event.metaKey || event.altKey) return;
      // Only when nothing in particular has the keyboard, so typing and the minigame are left alone.
      if (event.target !== document.body && event.target !== root) return;
      const down = ['PageDown', 'ArrowDown'].includes(event.key) || (event.key === ' ' && !event.shiftKey);
      const up = ['PageUp', 'ArrowUp'].includes(event.key) || (event.key === ' ' && event.shiftKey);
      if ((!down && !up) || root.classList.contains('gated')) return;
      const here = place(active);
      if (down && active < stages.length - 1 && scrollY >= here.end - 1) {
        event.preventDefault();
        glide(place(active + 1).top);
      } else if (up && active > 0 && scrollY <= here.top + 1) {
        event.preventDefault();
        glide(place(active - 1).end);
      }
    });

    addEventListener('resize', () => {
      screens.forEach(fit);
      update();
    });

    // A link to a stage is followed by the browser as usual. A link to a section inside one
    // cannot be: the screen it is on is held in place, so the browser would not find it.
    document.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
      if (!link || !link.hash || link.origin !== location.origin || link.pathname !== location.pathname) return;
      const target = document.getElementById(link.hash.slice(1));
      const index = target ? screens.findIndex((screen) => screen.contains(target)) : -1;
      if (!target || index === -1) return;
      event.preventDefault();
      history.pushState(null, '', link.hash);
      goInside(index, target);
    });

    // Tabbing into a stage that is not showing (they are all still on the page) brings it up.
    document.addEventListener('focusin', (event) => {
      const target = screens.findIndex((screen) => screen.contains(event.target as Node));
      if (target === -1 || target === active) return;
      window.scrollTo({ top: window.scrollY + stages[target].getBoundingClientRect().top - restingTop() });
    });

    // A link straight to a stage or section (/#projects) was followed before the stages were
    // laid out, when the page was still one long scroll, so it has to be followed again now.
    screens.forEach(fit);
    const wanted = location.hash ? document.getElementById(location.hash.slice(1)) : null;
    const inside = wanted ? screens.findIndex((screen) => screen.contains(wanted)) : -1;
    if (wanted && stages.includes(wanted)) wanted.scrollIntoView({ behavior: 'instant' });
    else if (wanted && inside !== -1) goInside(inside, wanted, 'instant');

    update();
  }
</script>
