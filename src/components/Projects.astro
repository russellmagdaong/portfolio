---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import SectionHeading from './SectionHeading.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="container-page py-16 sm:py-24" data-accent="magenta">
  <SectionHeading index="02" kicker="Projects" title="What I've been building" />

  <div class="space-y-10">
    {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
  </div>
</section>
