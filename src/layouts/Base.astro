---
import '@fontsource/press-start-2p';
import '@fontsource-variable/ibm-plex-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · I build games that teach things`;
// Only known once `site` is set in astro.config.mjs.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#06060c" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />

    <!--
      Marks the page as scripted, which is what hides blocks until they scroll in (see global.css).
      If effects.ts has not reported in after a few seconds, the mark comes off again so that
      nothing is left hidden.
    -->
    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(() => {
        if (!document.documentElement.dataset.effects) document.documentElement.classList.remove('js');
      }, 5000);
    </script>
  </head>
  <body class="min-h-dvh">
    <!-- For a full-screen layer that has to be in place before the page is drawn, such as the entry screen. -->
    <slot name="overlay" />
    <a
      href="#main"
      class="btn btn-solid sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
      data-accent="acid"
    >
      Skip to content
    </a>
    <Header />
    <!-- Clipped sideways because blocks slide in from just outside the edge. -->
    <main id="main" class="overflow-x-clip">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/effects.ts';
    </script>
  </body>
</html>
