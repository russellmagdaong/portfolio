---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Shape from '../../components/Shape.astro';
import { accentBg } from '../../lib/accent';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, summary, year, tags, accent, repo, demo } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary}>
  <article class="container-page max-w-3xl pt-12 pb-20 sm:pt-16">
    <a href={url('/#projects')} class="link-underline font-semibold">← All projects</a>

    <header
      class:list={[
        'relative mt-8 overflow-hidden rounded-[2rem] border-2 border-line p-8 text-night shadow-pop-lg sm:p-12',
        accentBg[accent],
      ]}
    >
      <Shape kind="burst" class="absolute -top-10 -right-10 size-40 animate-spin-slow fill-white/60 stroke-night" />
      <p class="relative font-mono text-sm font-bold">{year}</p>
      <h1 class="relative mt-2 text-5xl leading-none font-extrabold sm:text-6xl">{title}</h1>
      <p class="relative mt-4 max-w-xl text-xl font-medium">{summary}</p>
    </header>

    <ul class="mt-8 flex flex-wrap gap-2">
      {tags.map((tag) => <li class="chip">{tag}</li>)}
    </ul>

    {
      (demo || repo) && (
        <div class="mt-6 flex flex-wrap gap-4">
          {demo && (
            <a href={demo} target="_blank" rel="noopener noreferrer" class="btn bg-sun">
              Live demo ↗
            </a>
          )}
          {repo && (
            <a href={repo} target="_blank" rel="noopener noreferrer" class="btn bg-card text-ink">
              Source code ↗
            </a>
          )}
        </div>
      )
    }

    <div class="prose-fun mt-12">
      <Content />
    </div>
  </article>
</Base>
