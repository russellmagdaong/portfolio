---
// Credentials: the trophy shop. The awards are on a plaque and the certificates hang framed on
// the walls; clicking one shows it full size.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Game from '../layouts/Game.astro';
import Show from '../components/game/Show.astro';
import { achievements, certificates, organizations } from '../data/site';
import { sceneConfig } from '../game/config';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/certificates/*/*.jpg', { eager: true });
const image = (folder: string, file: string) => {
  const found = files[`../assets/certificates/${folder}/${file}.jpg`];
  if (!found) throw new Error(`Certificate image not found: ${folder}/${file}.jpg`);
  return found.default;
};
// Show ids match the show: slices in art/scenes/trophy-shop.aseprite.
---

<Game title="Credentials" config={sceneConfig('trophy-shop')}>
  <Show id="achievements" title="Awards and organizations">
    <ul class="show-list show-cols">
      {
        achievements.map((item) => (
          <li>
            <strong>{item.title}</strong>
            {item.detail && <span class="block opacity-75">{item.detail}</span>}
          </li>
        ))
      }
    </ul>
    <p class="show-heading mt-[0.8em]" aria-hidden="true">Organizations</p>
    <h3 class="sr-only">Organizations</h3>
    <ul class="show-list">
      {
        organizations.map((org) => (
          <li>
            <strong>{org.role}</strong>, {org.group}
            <span class="block opacity-75">{org.years}</span>
          </li>
        ))
      }
    </ul>
  </Show>

  {
    certificates.map((group) => (
      <Show id={`certs-${group.folder}`} title={group.label} fit={5}>
        <ul class="show-frames">
          {group.items.map((item) => (
            <li>
              <button
                type="button"
                data-cert-open={image(group.folder, item.file).src}
                data-cert-title={item.title}
                data-cert-detail={item.detail}
                data-cert-group={group.label}
                title={`${item.title}: ${item.detail}`}
              >
                <Image src={image(group.folder, item.file)} width={320} alt="" />
                <span class="show-frame-title">{item.title}</span>
                <span class="show-frame-detail">{item.detail}</span>
              </button>
            </li>
          ))}
        </ul>
      </Show>
    ))
  }

  {/* The certificate up close is opened by these and by the text page's; it lives in TextSite.astro. */}
</Game>

<style is:global>
  /* ---------- Popups in the gallery (the AWARDS room) ----------
     On top of the trophy-shop block under "Scene themes" in src/styles/game.css: the same --ui-*
     variables, set again here (with :root, so these win) in the room's own colours from
     art/palette.gpl: the navy wallpaper (D denim dark) with its gold damask (neon yellow dim), the
     gilt frames (g gold, sodium 1/4/5), the brass plates under them and the dark wood (wood 1-3).
     A panel (Controls) and the certificate up close hang in a gilt frame on the wallpaper, their
     title on an engraved brass plate with two rivets; the keys are small brass plates. The key
     prompt and the Exit tag over him are brass plates too, like the ones under the frames. */
  html.game[data-scene='trophy-shop']:root {
    --ui-bg:
      radial-gradient(circle at 50% 50%, rgb(150 120 30 / 0.32) 0 1.5px, transparent 2px) 0 0 / 32px 24px,
      radial-gradient(circle at 50% 50%, rgb(150 120 30 / 0.32) 0 1.5px, transparent 2px) 16px 12px / 32px 24px,
      #1f3158;
    --ui-head-bg: #dcb55a;
    --ui-line: #783c16;
    --ui-shadow: 0 0 0 2px #ffcd78, 0 0 0 5px #dcb55a, 0 0 0 7px #2c1c16, 0 10px 0 7px #000;
    --ui-rule: rgb(220 181 90 / 0.28);
    --ui-fg: #ece2c8;
    --ui-strong: #ffeebe;
    --ui-muted: #b6b3c8;
    --ui-title: #ffcd78;
    --ui-head-fg: #2c1c16;
    --ui-kicker: #6e482c;
    --ui-accent: #ffcd78;
    --ui-close-bg: #2c1c16;
    --ui-close-fg: #ffcd78;
    --ui-close-line: #783c16;
    --ui-backdrop: rgb(14 20 40 / 0.9);
    --ui-mat: #f2e8d0;
    --ui-plate-bg: #dcb55a;
    --ui-plate-fg: #2c1c16;
    --ui-plate-title: #2c1c16;
  }

  /* The engraved brass plate: lit along the top, shaded along the bottom, a rivet at each end. */
  html.game[data-scene='trophy-shop'] :is(.gpanel-head, .cert-head) {
    align-items: center;
    padding-left: 26px;
    padding-right: 30px;
    background:
      radial-gradient(circle, #ffeebe 0 1.5px, #c46824 2px 3px, #783c16 3px 4px, transparent 4.5px) left 9px center / 10px 10px no-repeat,
      radial-gradient(circle, #ffeebe 0 1.5px, #c46824 2px 3px, #783c16 3px 4px, transparent 4.5px) right 9px center / 10px 10px no-repeat,
      linear-gradient(#ffcd78 0 2px, transparent 2px calc(100% - 4px), #c46824 calc(100% - 4px) calc(100% - 2px), #783c16 calc(100% - 2px)),
      #dcb55a;
  }

  html.game[data-scene='trophy-shop'] .gpanel-title {
    line-height: 1.3;
    text-shadow: 0 1px 0 #ffeebe;
  }

  html.game[data-scene='trophy-shop'] .cert-group {
    text-shadow: 0 1px 0 #ffeebe;
  }

  html.game[data-scene='trophy-shop'] .gpanel-close:hover {
    color: #2c1c16;
    background: #ffcd78;
    border-color: #2c1c16;
  }

  /* The plate under a certificate up close gets the rivets too. */
  html.game[data-scene='trophy-shop'] .cert-plate {
    padding-inline: 26px;
    background:
      radial-gradient(circle, #ffeebe 0 1.5px, #c46824 2px 3px, #783c16 3px 4px, transparent 4.5px) left 8px center / 10px 10px no-repeat,
      radial-gradient(circle, #ffeebe 0 1.5px, #c46824 2px 3px, #783c16 3px 4px, transparent 4.5px) right 8px center / 10px 10px no-repeat,
      #dcb55a;
  }

  html.game[data-scene='trophy-shop'] .cert-title {
    text-shadow: 0 1px 0 #ffeebe;
  }

  /* On a short screen (a phone held sideways) the frame's wide margins leave the certificate tiny:
     tighter margins and a smaller plate give the picture the height. */
  @media (max-height: 520px) {
    html.game[data-scene='trophy-shop'] .cert-head {
      padding-block: 6px;
    }

    html.game[data-scene='trophy-shop'] .cert-frame {
      margin: 12px 14px 0;
      padding: 6px;
    }

    html.game[data-scene='trophy-shop'] .cert-frame img {
      max-height: calc(94dvh - 170px);
    }

    html.game[data-scene='trophy-shop'] .cert-plate {
      margin: 10px auto 10px;
      padding-block: 4px 6px;
    }

    html.game[data-scene='trophy-shop'] .cert-title {
      line-height: 1.2;
    }
  }

  /* Keys: small brass plates. */
  html.game[data-scene='trophy-shop'] .gpanel .keycap {
    color: #2c1c16;
    background: #dcb55a;
    border-color: #783c16;
    box-shadow:
      inset 0 1px 0 #ffcd78,
      0 2px 0 #2c1c16;
  }

  /* A certificate pointed at in the room, enlarged beside its frame: in a small gilt frame on a mat. */
  html.game[data-scene='trophy-shop'] .cert-zoom {
    padding: 6px;
    background: #f2e8d0;
    border: 3px solid #dcb55a;
    box-shadow:
      0 0 0 2px #783c16,
      0 0 0 4px #2c1c16,
      0 8px 0 4px #000;
  }

  /* The key prompt and the Exit tag over him: a brass plate with navy keys. */
  html.game[data-scene='trophy-shop'] .prompt {
    color: #2c1c16;
    background: #dcb55a;
    border-color: #783c16;
    box-shadow:
      inset 0 2px 0 #ffcd78,
      inset 0 -2px 0 #c46824,
      0 0 0 2px #2c1c16,
      0 4px 0 2px #000;
  }

  html.game[data-scene='trophy-shop'] .prompt kbd {
    color: #ffcd78;
    background: #263f6c;
  }

  html.game[data-scene='trophy-shop'] .prompt.exit-tag:is(:hover, :focus-visible) {
    color: #ffcd78;
    background: #263f6c;
    border-color: #dcb55a;
  }

  html.game[data-scene='trophy-shop'] .prompt.exit-tag:is(:hover, :focus-visible) kbd {
    color: #2c1c16;
    background: #dcb55a;
  }
</style>
