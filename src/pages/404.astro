---
import Game from '../layouts/Game.astro';
import Icon from '../components/Icon.astro';
import Wordmark from '../components/Wordmark.astro';
import { MAP_PATH } from '../game/places';
import { site } from '../data/site';
---

<Game title="Page not found">
  <section class="t-404" data-sign="post-office">
    <a href="/" class="t-404-mark" aria-label={`${site.name}, home`}><Wordmark size={24} /></a>
    <div class="t-404-card">
      <h1 class="t-title">Nobody lives here</h1>
      <p>This page doesn't exist. Every place is on the street.</p>
      <p class="t-404-postmark">Returned to sender</p>
      <div class="t-404-actions">
        <a href={MAP_PATH} class="t-btn t-btn-primary"><Icon name="play" class="size-4" />The street</a>
        <a href="/" class="t-textlink">Home</a>
      </div>
    </div>
  </section>
</Game>
