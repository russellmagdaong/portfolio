---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';
---

<Base title="Page not found">
  <section class="container-page grid min-h-[72dvh] place-items-center py-16 text-center">
    <div>
      <p class="font-mono text-sm tracking-[0.22em] text-magenta uppercase">Error: signal lost</p>
      <h1 class="glitch mt-6 font-display text-[clamp(4rem,22vw,10rem)] leading-none text-white" data-text="404">
        404
      </h1>
      <p class="mt-4 text-lg text-fg">This page doesn't exist.</p>
      <a href={url('/')} class="btn btn-solid mt-8" data-accent="acid"><Icon name="play" />Back to start</a>
    </div>
  </section>
</Base>
