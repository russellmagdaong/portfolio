---
import Base from '../layouts/Base.astro';
import Shape from '../components/Shape.astro';
import { url } from '../lib/url';
---

<Base title="Page not found">
  <section class="container-page relative grid min-h-[70dvh] place-items-center py-20 text-center">
    <div>
      <div class="relative inline-block">
        <Shape kind="burst" class="absolute -top-8 -right-12 size-24 animate-spin-slow fill-sun" />
        <h1 class="text-[9rem] leading-none font-extrabold sm:text-[14rem]">404</h1>
      </div>
      <p class="mt-2 font-display text-2xl font-bold sm:text-3xl">This page wandered off.</p>
      <p class="mt-3 text-lg text-muted">It might have been moved, renamed, or never existed at all.</p>
      <a href={url('/')} class="btn mt-8 bg-pink">Take me home</a>
    </div>
  </section>
</Base>
