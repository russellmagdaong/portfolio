---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Tools from '../components/Tools.astro';
import Credentials from '../components/Credentials.astro';
import Entry from '../components/Entry.astro';
import Contact from '../components/Contact.astro';
import PulseLine from '../components/PulseLine.astro';
import Runner from '../components/Runner.astro';
---

<Base>
  <Entry slot="overlay" />
  <Hero />
  <Runner />
  <About />
  <Projects />
  <Tools />
  <Credentials />
  <PulseLine accent="acid" reverse />
  <Contact />
</Base>
