---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Tools from '../components/Tools.astro';
import Credentials from '../components/Credentials.astro';
import Entry from '../components/Entry.astro';
import Contact from '../components/Contact.astro';
import Runner from '../components/Runner.astro';
import Stage from '../components/Stage.astro';
---

<Base>
  <Entry slot="overlay" />
  <!-- Each stage is one screenful; the ids are what the header's links point at. -->
  <Stage>
    <Hero />
    <Runner />
  </Stage>
  <Stage id="about"><About /></Stage>
  <Stage id="projects"><Projects /></Stage>
  <Stage id="tools"><Tools /></Stage>
  <!-- Two short sections on one screen, so that neither sits alone in an empty window. -->
  <Stage id="other" last>
    <Credentials />
    <Contact />
  </Stage>
</Base>
