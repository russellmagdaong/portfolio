---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Tools from '../components/Tools.astro';
import Credentials from '../components/Credentials.astro';
import Contact from '../components/Contact.astro';
import { interests, tools } from '../data/site';

const toolNames = tools.flatMap((group) => group.items.map((item) => item.name));
---

<Base>
  <Hero />
  <Ticker items={toolNames} accent="magenta" />
  <About />
  <Projects />
  <Tools />
  <Credentials />
  <Ticker items={interests} accent="acid" reverse />
  <Contact />
</Base>
